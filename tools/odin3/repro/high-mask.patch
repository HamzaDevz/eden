 #include <exception>
 #include <stdexcept>
 #endif
@@ -155,6 +156,24 @@ bool IsGPULevelHigh() {
     return values.current_gpu_accuracy == GpuAccuracy::High;
 }
 
+#ifdef __ANDROID__
+#include <sys/system_properties.h>
+#endif
+bool HiBit(int bit) {
+    static const unsigned mask = [] {
+        unsigned m = 0;
+#ifdef __ANDROID__
+        char buf[PROP_VALUE_MAX]{};
+        if (__system_property_get("debug.eden.hi", buf) > 0) {
+            m = static_cast<unsigned>(std::strtoul(buf, nullptr, 0));
+        }
+#endif
+        LOG_WARNING(Common, "HiBit mask {:#x}", m);
+        return m;
+    }();
+    return IsGPULevelHigh() || ((mask >> bit) & 1);
+}
+
 bool IsDMALevelDefault() {
     return values.dma_accuracy.GetValue() == DmaAccuracy::Default;
 }
